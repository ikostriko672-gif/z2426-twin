{
  "openapi": "3.0.3",
  "info": {
    "title": "Z1485 login-CSRF Try-It canary",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://httpbin.org"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key"
      }
    }
  },
  "paths": {
    "/status/200": {
      "get": {
        "operationId": "z1485QueryKey",
        "summary": "Z1485 list widgets (apiKey in query)",
        "security": [
          {
            "apiKeyQuery": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "fixed empty body"
          }
        }
      },
      "post": {
        "operationId": "z1485BodyLogin",
        "summary": "Z1485 token exchange (JSON body password)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "fixed empty body"
          }
        }
      }
    }
  }
}